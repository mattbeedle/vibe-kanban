# Vibe Kanban - Fly.io Deployment Environment Variables
# Copy this file and fill in values, then use `fly secrets set` to configure

# =============================================================================
# REQUIRED - Database
# =============================================================================

# PlanetScale PostgreSQL connection string
# Format: postgresql://username:password@host:port/database?sslmode=require
# Get from PlanetScale dashboard > Connect
SERVER_DATABASE_URL=postgresql://user:password@host.aws.planetscale.com:5432/vibe_kanban?sslmode=require

# =============================================================================
# REQUIRED - Security
# =============================================================================

# JWT secret for signing session tokens
# Generate with: openssl rand -base64 48
VIBEKANBAN_REMOTE_JWT_SECRET=

# Password for the electric_sync database role
# Generate with: openssl rand -base64 32
ELECTRIC_ROLE_PASSWORD=

# Public base URL of your deployment
# Production: https://vibe-kanban.fly.dev
# Custom domain: https://vibekanban.yourdomain.com
SERVER_PUBLIC_BASE_URL=https://vibe-kanban.fly.dev

# =============================================================================
# REQUIRED - OAuth (at least one provider)
# =============================================================================

# GitHub OAuth App
# Create at: https://github.com/settings/developers
# Callback URL: {SERVER_PUBLIC_BASE_URL}/v1/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth App (alternative to GitHub)
# Create at: https://console.cloud.google.com/apis/credentials
# Callback URL: {SERVER_PUBLIC_BASE_URL}/v1/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# =============================================================================
# OPTIONAL - ElectricSQL (for vibe-kanban-electric app)
# =============================================================================

# Database URL for Electric sync engine (uses electric_sync role)
# Only needed when deploying vibe-kanban-electric app
# Format: postgresql://electric_sync:password@host:port/database?sslmode=require
# DATABASE_URL=postgresql://electric_sync:password@host.aws.planetscale.com:5432/vibe_kanban?sslmode=require

# Electric auth secret (for secure mode)
# Generate with: openssl rand -base64 32
# AUTH_SECRET=

# =============================================================================
# OPTIONAL - Email Notifications (Loops)
# =============================================================================

# Loops API key for sending transactional emails
# Get from: https://app.loops.so/settings?page=api-keys
LOOPS_EMAIL_API_KEY=

# Loops email template IDs (use your own or leave as default)
LOOPS_INVITE_TEMPLATE_ID=cmhvy2wgs3s13z70i1pxakij9
LOOPS_REVIEW_READY_TEMPLATE_ID=cmj47k5ge16990iylued9by17
LOOPS_REVIEW_FAILED_TEMPLATE_ID=cmj49ougk1c8s0iznavijdqpo

# Enable email digest notifications
DIGEST_ENABLED=false

# =============================================================================
# OPTIONAL - File Attachments (Azure Blob Storage)
# =============================================================================

# Azure Storage account for issue attachments
# Create in Azure Portal or use Azurite for local dev
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=issue-attachments

# Optional: Custom Azure Storage endpoints
# AZURE_STORAGE_ENDPOINT_URL=
# AZURE_STORAGE_PUBLIC_ENDPOINT_URL=

# =============================================================================
# OPTIONAL - Review Artifacts (Cloudflare R2)
# =============================================================================

# Cloudflare R2 for storing PR review artifacts
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REVIEW_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_REVIEW_BUCKET=vibe-kanban-reviews

# Review worker base URL (if using separate review worker)
REVIEW_WORKER_BASE_URL=

# =============================================================================
# OPTIONAL - GitHub App Integration
# =============================================================================

# GitHub App for PR reviews and webhook automation
# Create at: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# =============================================================================
# OPTIONAL - Billing (requires FEATURES build arg)
# =============================================================================

# Stripe for billing and subscriptions
# Only available with private billing feature
STRIPE_SECRET_KEY=
STRIPE_TEAM_SEAT_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_SEAT_LIMIT=1

# =============================================================================
# OPTIONAL - Relay Server (vibe-kanban-relay app)
# =============================================================================

# Relay server URL for workspace tunneling
# Set after deploying vibe-kanban-relay app
# This is a build-time variable, pass via --build-arg
# VITE_RELAY_API_BASE_URL=https://vibe-kanban-relay.fly.dev

# =============================================================================
# OPTIONAL - Analytics (requires billing feature)
# =============================================================================

# PostHog for product analytics
# Build-time variables, pass via --build-arg
# POSTHOG_API_KEY=
# POSTHOG_API_ENDPOINT=https://app.posthog.com

# =============================================================================
# OPTIONAL - Error Tracking
# =============================================================================

# Sentry for error tracking
# Build-time variable, pass via --build-arg
# SENTRY_DSN_REMOTE=

# =============================================================================
# OPTIONAL - License Keys
# =============================================================================

# React Virtuoso license key (for table virtualization)
# Build-time variable, pass via --build-arg
# VITE_PUBLIC_REACT_VIRTUOSO_LICENSE_KEY=

# =============================================================================
# DEPLOYMENT COMMANDS
# =============================================================================

# Set secrets for main app (vibe-kanban):
# fly secrets set \
#   -a vibe-kanban \
#   SERVER_DATABASE_URL="..." \
#   VIBEKANBAN_REMOTE_JWT_SECRET="..." \
#   ELECTRIC_ROLE_PASSWORD="..." \
#   SERVER_PUBLIC_BASE_URL="..." \
#   GITHUB_OAUTH_CLIENT_ID="..." \
#   GITHUB_OAUTH_CLIENT_SECRET="..."

# Set secrets for Electric app (vibe-kanban-electric):
# fly secrets set \
#   -a vibe-kanban-electric \
#   DATABASE_URL="postgresql://electric_sync:password@..." \
#   AUTH_SECRET="..."

# Set secrets for Relay app (vibe-kanban-relay):
# fly secrets set \
#   -a vibe-kanban-relay \
#   SERVER_DATABASE_URL="..." \
#   VIBEKANBAN_REMOTE_JWT_SECRET="..."  # Must match main app

# Deploy main app:
# fly deploy \
#   --config crates/remote/fly.toml \
#   --dockerfile crates/remote/Dockerfile \
#   --build-arg FEATURES="" \
#   -a vibe-kanban

# Deploy Electric:
# fly deploy \
#   --config crates/remote/fly.electric.toml \
#   --image electricsql/electric:1.4.13 \
#   -a vibe-kanban-electric

# Deploy Relay:
# fly deploy \
#   --config crates/relay-tunnel/fly.toml \
#   --dockerfile crates/relay-tunnel/Dockerfile \
#   -a vibe-kanban-relay
